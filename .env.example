# =============================================================================
# RoteiroBR — variáveis de ambiente
# Copie este arquivo: cp .env.example .env
# Preencha os valores reais. Nunca committe o .env.
# =============================================================================

# --- Servidor ---
PORT=3000
NODE_ENV=development
# Gere com: openssl rand -base64 32
JWT_SECRET=troque-por-uma-chave-secreta-longa

# MySQL (local ou gerenciado)
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=mysql://user:senha@localhost:3306/roteiro_br

# --- OpenStreetMap (rotas e autocomplete) ---
# Opcionais: padrões usam demos públicos (Photon + OSRM).
# Em produção com tráfego alto, hospede as próprias instâncias.
PHOTON_URL=https://photon.komoot.io
OSRM_URL=https://router.project-osrm.org

# --- Login / histórico (OAuth Manus) ---
# Opcionais se você só quiser calcular rotas sem salvar histórico.
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=
OWNER_OPEN_ID=

# Forge (apenas se ainda usar storage/LLM/notificações do Manus)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
